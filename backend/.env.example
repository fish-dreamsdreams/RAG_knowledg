# 复制为仓库根目录或 backend/ 下的 .env 后按需修改
# 真实 .env 禁止提交

# ===== 依赖地址（宿主端口避开其他项目占用） =====
DATABASE_URL=postgresql+asyncpg://kb:kb_dev_password@127.0.0.1:15432/knowledge_base
REDIS_URL=redis://127.0.0.1:16379/0
CELERY_BROKER_URL=redis://127.0.0.1:16379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/2
MILVUS_URI=http://127.0.0.1:19530
# 业务对象存储（与 Milvus 内部的 minio 是两个实例：后者仅供 Milvus 使用且不发布端口）
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_ACCESS_KEY=kb_minio
MINIO_SECRET_KEY=kb_minio_dev_password
MINIO_BUCKET=kb-assets
MINIO_SECURE=false

# ===== 安全 =====
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
# 模型配置里 API Key 的 Fernet 密钥（urlsafe base64 的 32 字节，可 python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())" 生成）
# 留空则从 SECRET_KEY 派生；轮换 SECRET_KEY 会让已存密文失效，生产请显式配置
CONFIG_ENCRYPTION_KEY=
# 看板"今日/近 7 天"与按天趋势的换算时区（审计时间戳存 UTC）
REPORT_TIMEZONE=Asia/Shanghai

# ===== Chat 网关（仅 Chat；Embedding 走本地 BGE-M3） =====
LLM_BASE_URL=
LLM_API_KEY=
# 模型名：随网关而异，必填（DeepSeek 网关下是 deepseek-flash / deepseek-v4-pro）
LLM_CHAT_MODEL=
# 单次 Chat 调用超时（秒）
LLM_TIMEOUT_SECONDS=60

# 本地模型（本机 RTX 5070 Laptop：单卡 8GB，够跑 BGE-M3 + bge-reranker-base）
EMBED_MODEL=BAAI/bge-m3
# 无显卡的机器改回 cpu；Blackwell 显卡需 CUDA 12.8 版 torch
EMBED_DEVICE=cuda
EMBED_SPARSE_ENABLED=true
# 启动即预热（加载权重 + 跑一次空编码）；关闭后首次使用才加载
EMBED_WARMUP_ENABLED=true
# v2-m3 是 XLM-RoBERTa-Large（568M）：中文/多语言排序明显强于 base，但显存与耗时约 2x
# 换模型后 RERANK_CLIFF_MIN_DROP 必须在新分数分布上重新标定（见 scripts/calibrate_rerank.py）
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 留空跟 EMBED_DEVICE；显存紧张时单独把重排放 cpu（重排不写向量库，换设备不影响存量向量）
RERANK_DEVICE=
HF_HOME=
HYDE_ENABLED=true
RERANK_CLIFF_MIN_KEEP=3
RERANK_CLIFF_MAX_KEEP=10
# 归一化落差比（落差 / 最高分），不是绝对落差
RERANK_CLIFF_MIN_RATIO=0.13
# FAQ 挖掘的语义归并阈值（比 faq_sim_threshold 宽）
FAQ_CLUSTER_SIM=0.8

# ===== MinerU 在线 API =====
MINERU_API_BASE_URL=https://mineru.net/api/v4
# 控制台给的是 Access Key / Secret Key 一对；客户端目前只做 Bearer 认证，先填 Access Key
MINERU_API_KEY=
MINERU_SECRET_KEY=
MINERU_MODEL_VERSION=pipeline
MINERU_LANGUAGE=ch
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_TASK_TIMEOUT_SECONDS=900
MINERU_OUTPUT_DIR=./var/mineru

# ===== 导入与上传 =====
INGEST_CONCURRENCY=4
# 已废弃：原件改存 MinIO；仅历史本地文件兼容用
UPLOAD_DIR=./var/uploads

# ===== 图片资产（解出上限，超限跳过；不阻断导入） =====
ASSET_MAX_FILE_BYTES=10485760
ASSET_MAX_TOTAL_BYTES=104857600
ASSET_MAX_FILES=200

# ===== 视觉图注（只对 pdf/docx；默认关闭。只做 API 调用，不部署模型） =====
ASSETS_VISION_ENABLED=false
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_CONCURRENCY=3
VISION_MAX_IMAGES_PER_UNIT=50

# ===== 答案附图：单条答案最多下发几张图（0 = 关闭；P0 只进引用卡片，不内联正文） =====
ANSWER_MAX_IMAGES=3
